# Base de datos
# Para desarrollo local: dejar vacío (usa SQLite)
# Para producción (Supabase): DATABASE_URL="postgresql://postgres:[password]@db.xxx.supabase.co:5432/postgres"
DATABASE_URL=

# JWT Secret (se genera automáticamente en Render)
JWT_SECRET=

# Orígenes permitidos (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,https://petllamaid.netlify.app

# Puerto (solo Render usa PORT)
PORT=3000
